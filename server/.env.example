# ============================================
# Server Configuration
# ============================================

# Server Port
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================

# MongoDB Connection URI
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Examples:
#   - Local: mongodb://localhost:27017/bridge-ai
#   - Atlas: mongodb+srv://username:password@cluster.mongodb.net/bridge-ai
MONGODB_URI=mongodb://localhost:27017/bridge-ai

# ============================================
# JWT Configuration
# ============================================

# JWT Secret Key (for signing tokens)
# IMPORTANT: Use a strong, random secret in production
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# Firebase Authentication Configuration
# ============================================

# Option 1: Firebase Service Account Key (Recommended for production)
# Download service account key from Firebase Console:
#   1. Go to Firebase Console -> Project Settings -> Service Accounts
#   2. Click "Generate New Private Key"
#   3. Download the JSON file
#   4. Copy the entire JSON content and paste it here as a single line (or use a JSON file path)
# 
# Format: {"type":"service_account","project_id":"...","private_key_id":"...",...}
# 
# Note: For production, consider storing this in a secure secret management system
# rather than environment variables.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option 2: Firebase Project ID (Alternative for development/testing)
# Use this if you don't have a service account key
# Get your project ID from Firebase Console -> Project Settings -> General
FIREBASE_PROJECT_ID=your-firebase-project-id

# ============================================
# Frontend Configuration
# ============================================

# Frontend URL (for CORS and redirects)
# Used for:
#   - CORS configuration
#   - Firebase OAuth redirects
#   - API response redirects
FRONTEND_URL=http://localhost:3000

# ============================================
# Additional Notes
# ============================================

# 1. Firebase Authentication Setup:
#    - Create a Firebase project at https://console.firebase.google.com
#    - Enable Firebase Authentication
#    - Enable Google Sign-In provider (or other providers as needed)
#    - Generate service account key or use project ID
#
# 2. Security Best Practices:
#    - Never commit .env file to version control
#    - Use strong, random secrets for JWT_SECRET
#    - Store sensitive keys in secure secret management systems in production
#    - Use environment-specific .env files (.env.development, .env.production)
#
# 3. MongoDB Setup:
#    - For local development: Install MongoDB and run locally
#    - For production: Use MongoDB Atlas or similar cloud service
#    - Update MONGODB_URI with your connection string
#
# 4. Required vs Optional:
#    - Required: MONGODB_URI, JWT_SECRET, FIREBASE_SERVICE_ACCOUNT_KEY or FIREBASE_PROJECT_ID
#    - Optional: PORT (defaults to 5000), NODE_ENV (defaults to development), FRONTEND_URL
